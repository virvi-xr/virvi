{
  "name": "@virvixr/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "catalog:import": "tsx src/scripts/catalog-import.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-s3": "^3.1016.0",
    "@colyseus/redis-driver": "^0.17.6",
    "@colyseus/redis-presence": "^0.15.6",
    "@colyseus/ws-transport": "^0.15.0",
    "@dcl/crypto": "3.7.0",
    "@dcl/crypto-middleware": "6.3.0",
    "@dcl/hashing": "3.0.4",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "@virvixr/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "colyseus": "^0.15.26",
    "dcl-catalyst-client": "23.0.0",
    "drizzle-orm": "^0.38.0",
    "ethers": "6",
    "fast-jwt": "^5",
    "fastify": "^5.2.0",
    "fflate": "^0.8.2",
    "google-auth-library": "^10.6.2",
    "maxmind": "^4",
    "nodemailer": "^8.0.3",
    "postgres": "^3.4.0",
    "prom-client": "^15.1.3",
    "qrcode": "1.5.4",
    "sharp": "^0.33.0",
    "stripe": "^17.0.0",
    "undici": "6.21.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "colyseus.js": "^0.15.26",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3"
  }
}
