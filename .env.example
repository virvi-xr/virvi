# =============================================================================
# Virvi V2 — Environment Variables
# =============================================================================
# Copy to .env and edit. Only REQUIRED vars need values to start.
#
# Modes:
#   single   — One server, in-memory presence, all features free (default)
#   scalable — Multiple servers + Redis, all features free
#   cloud    — Multi-tenant SaaS with billing + feature gating

# =============================================================================
# REQUIRED (all modes)
# =============================================================================
VIRVI_MODE=single
DATABASE_URL=postgresql://vlm:vlm_dev@localhost:5432/vlm
JWT_SECRET=change-me-to-a-random-64-char-string
PUBLIC_URL=http://localhost:3010
# Origin of the dashboard web app; used as the domain/URI in wallet sign-in (EIP-4361) messages. Defaults to PUBLIC_URL.
# WEB_APP_URL=http://localhost:3010

# =============================================================================
# STORAGE
# =============================================================================
# Provider: local (default) | s3 | r2 (anything else stops the server at boot)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
# Private files (scene import sources and builds, single mode). Must be OUTSIDE LOCAL_STORAGE_PATH (that folder is served
# publicly) and on persistent storage. Default: a "private" folder beside LOCAL_STORAGE_PATH.
# PRIVATE_STORAGE_PATH=./private
# Private bucket for scene imports (required in scalable and cloud modes): s3://<key>:<secret>@<account>.r2.cloudflarestorage.com/<bucket>, or file://<dir>
# SCENE_IMPORT_S3_URI=
# Where uploaded scenes are built (apps/scene-builder/README.md): fly (a one-shot machine per build), local (runs
# apps/scene-builder/build.mjs on this server with no isolation: development only, refused in cloud mode; needs
# `npm install` in apps/scene-builder) or off (imports are refused). Default: fly in cloud mode, otherwise off.
# SCENE_BUILD_RUNNER=off
# The build image (fly): registry.fly.io/virvi-scene-builds:<label>
# SCENE_BUILD_IMAGE=
# The Fly app build machines run in (default virvi-scene-builds), and a Fly token scoped to that app only
# SCENE_BUILD_FLY_APP=virvi-scene-builds
# SCENE_BUILD_FLY_TOKEN=

# S3 / R2:
# S3_BUCKET=vlm-media
# S3_REGION=auto                         # Use "auto" for R2
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com  # For R2 or MinIO (omit for AWS S3)
# AWS_ACCESS_KEY_ID=                     # R2 or S3 access key
# AWS_SECRET_ACCESS_KEY=                 # R2 or S3 secret key
# CDN_URL=https://cdn.virvi.io             # Custom domain for public file URLs (optional)

# =============================================================================
# SCALABLE / CLOUD MODE
# =============================================================================
# REDIS_URL=redis://localhost:6379       # Required for scalable/cloud

# =============================================================================
# BILLING (cloud mode only — omit = all features free)
# =============================================================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# =============================================================================
# OPTIONAL — Features
# =============================================================================
# ENABLE_STREAMING=false                 # HLS streaming (requires FFmpeg)
# ENABLE_METRICS=false                   # Prometheus /metrics endpoint

# =============================================================================
# OPTIONAL — Email (SMTP)
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@virvi.io

# =============================================================================
# OPTIONAL — Auth providers (omit to disable)
# =============================================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_CALLBACK_URL=                   # Base URL for OAuth callbacks (defaults to PUBLIC_URL)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# API keys are managed via /api/keys endpoints (no env config needed)
# Accept unverified Decentraland logins (local preview only). Never set in production.
# ALLOW_UNVERIFIED_PLATFORM_AUTH=false
# Oldest Decentraland HUD edit protocol allowed to write (header x-virvi-hud-protocol; none = 0).
# Older HUDs get 426 and show "This scene needs a redeploy to edit". Raise only when a release breaks old HUDs' edits.
# MIN_DCL_HUD_PROTOCOL=0

# =============================================================================
# OPTIONAL — Decentraland (Worlds deploys)
# =============================================================================
# Private key of a wallet used only for World deploys it has been granted, never a user's key.
VIRVI_DCL_DEPLOY_KEY=
# A separate wallet for Genesis City parcels, which owners make an update operator on-chain. Unset hides that option.
VIRVI_DCL_PARCEL_DEPLOY_KEY=
# Interval in ms for the Decentraland redeploy sweep
DCL_REDEPLOY_SWEEP_MS=30000
# How often to check whether Decentraland built a map snapshot for new deploys (0 disables)
DCL_MAP_SWEEP_MS=60000

# =============================================================================
# OPTIONAL — Tuning
# =============================================================================
PORT=3010
# LOG_LEVEL=info                         # debug | info | warn | error
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d
# MAX_ROOMS=50                           # Max concurrent Colyseus rooms per server
# TRUST_PROXY_HOPS=1                     # Reverse-proxy hops to trust for client IP (Railway = 1)
# RATE_LIMIT_MAX=300                     # Max API requests per minute per IP (global)
# MAX_UPLOAD_MB=100                      # Max upload body size in MB (default 100)
# DB_POOL_MAX=10                         # Max database connections in pool
# DASHBOARD_DIR=./dashboard              # Path to static dashboard files
# Venue booking lifecycle sweep interval in ms (0 disables)
# LIFECYCLE_SWEEP_MS=5000

# =============================================================================
# Docker Compose helpers (used by compose files, not by the app directly)
# =============================================================================
# POSTGRES_PASSWORD=vlm_prod

# --- Analytics ---
# Optional country database for analytics (mmdb, e.g. DB-IP Lite "dbip-country-lite" — CC-BY 4.0,
# attribution required). Without it, countries come only from a CDN header such as cf-ipcountry.
# GEOIP_COUNTRY_DB_PATH=/data/dbip-country-lite.mmdb

# --- Design Studio: pay in MANA (Polygon PoS) ---
# MANA is off until a recipient is set; a bad address refuses to start. Confirm the token on Polygonscan first.
# STUDIO_MANA_RECIPIENT=0x01d871870CbBddE934526E17637c0cfEf0b3b38B
# Production: use a paid RPC (such as Alchemy); the free public node is slow and rate limited
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# STUDIO_MANA_TOKEN=0xA1c57f48F0Deb89f569dFbE6E2B7f46D33606fD4
# The studio scene's base parcel (x,y): only it gets a studio pass, and only from an official Genesis City realm
# STUDIO_SCENE_PARCEL=-12,34
