{
  "name": "@virvixr/adapter-dcl",
  "version": "2.0.0",
  "private": true,
  "description": "Virvi Platform Adapter for Decentraland SDK 7",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "default": "./dist/analytics.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "@dcl/sdk": ">=7.26.0",
    "@virvixr/client": "workspace:*",
    "@virvixr/core": "workspace:*",
    "@virvixr/shared": "workspace:*"
  },
  "devDependencies": {
    "@dcl/sdk": "7.30.1",
    "@virvixr/client": "workspace:*",
    "@virvixr/core": "workspace:*",
    "@virvixr/shared": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "3.2.7"
  },
  "bundledDependencies": [
    "colyseus.js"
  ],
  "dependencies": {
    "colyseus.js": "^0.15.26"
  }
}
